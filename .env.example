# === Required ===
PII_MASTER_KEY=          # 32+ byte key for PII encryption (hex-encoded recommended: 64 hex chars)

# === Optional (with defaults) ===
VASP_DID=did:web:vasp.example.com
CIRCUIT_ARTIFACTS_DIR=./artifacts
CORS_ALLOWED_ORIGINS=http://localhost:3000
SIWE_DOMAIN=localhost
HKDF_SALT=              # Required stable random deployment salt; encoded as UTF-8, not hex-decoded.
ALLOW_INSECURE_HKDF_SALT= # Local tests/demos only: exactly 1 opts into the historical default.

# === Durable current-profile proving (operator configuration) ===
# DATABASE_URL=<PostgreSQL connection; keep in a secret manager>
# PILOT_PROVING_FACTORY=operator_pilot:configure
# The API and separate Linux worker share database, PII keyring and pinned targets.
# Worker: uv run python -m src.prover.proof_job_worker
# See docs/operations/pilot-proving-jobs.md for admission limits and recovery.

# === Recipient encryption and discovery (development profile 0.4.0) ===
PII_ENVELOPE_MODE=hpke-v2
HPKE_DISCOVERY_ENABLED=1
DISCOVERY_PRIVATE_DESTINATIONS={}
# Set an HPKE public key or configure the beneficiary DID for discovery.
# BENEFICIARY_HPKE_PUBLIC_KEY=<base64url X25519 public key>
# To publish discovery, set VASP_DOMAIN and a matching VASP_DID and HPKE key.
# VASP_DOMAIN=vasp.example.com
# VASP_HPKE_PRIVATE_KEY=<base64url X25519 private key; store in a secret manager>
# See specs/well-known-clearproof.md for migration and private enterprise policy.

# === Deployment (contract operations only) ===
DEPLOYER_PRIVATE_KEY=    # Wallet private key for contract deployment
SEPOLIA_RPC_URL=         # Sepolia RPC endpoint (e.g., Alchemy/Infura)
