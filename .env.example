# === Required ===
PII_MASTER_KEY=          # 32+ byte key for PII encryption (hex-encoded recommended: 64 hex chars)

# === Optional (with defaults) ===
VASP_DID=did:web:vasp.example.com
CIRCUIT_ARTIFACTS_DIR=./artifacts
CORS_ALLOWED_ORIGINS=http://localhost:3000
HKDF_SALT=              # Required stable random deployment salt; encoded as UTF-8, not hex-decoded.
ALLOW_INSECURE_HKDF_SALT= # Local tests/demos only: exactly 1 opts into the historical default.

# === Authentication (loaded once at FastAPI lifespan startup) ===
AUTH_MODE=api-key        # "api-key", "jwt", or "siwe"
API_KEY=                 # Required when AUTH_MODE=api-key
# Static API-key tenant principal binding (required for pilot routes in api-key mode):
# API_KEY_TENANT_ID=
# API_KEY_ACTOR_ID=
# API_KEY_ROLES=         # Comma-separated roles (e.g. proof:inspect,evidence:decrypt)
# API_KEY_ISSUER_DIDS=   # Optional comma-separated canonical did:web scopes
# ES256 JWT verification (required when AUTH_MODE=jwt):
# JWT_PUBLIC_KEY=        # PEM-encoded ES256 public key
JWT_ISSUER=zk-travel-rule
JWT_AUDIENCE=zk-travel-rule-api
SIWE_DOMAIN=localhost
# SIWE_MAX_SESSIONS=10000  # Max tracked SIWE sessions (persisted in PostgreSQL siwe_sessions when DATABASE_URL is set; in-memory LRU fallback only when DATABASE_URL is absent)
# SIWE tenant principal binding (required for /pilot/* and /wallet/ownership/* routes in siwe mode):
# SIWE_TENANT_ID=
# SIWE_ACTOR_ID=         # Optional; defaults to the authenticated SIWE session address (lowercased)
# SIWE_ROLES=            # Comma-separated roles (e.g. usage:read,proof:inspect)
# SIWE_ISSUER_DIDS=      # Optional comma-separated canonical did:web scopes

# === Legacy API surface (deprecated; scheduled for removal before 1.0.0) ===
# Gates legacy routers (/proof/*, /credential/*, /metrics).
# Defaults to enabled (1) for compatibility when unset, EXCEPT when CLEARPROOF_PROFILE
# is set to "pilot" or "production" where legacy routers default to disabled (0).
# Set CLEARPROOF_ENABLE_LEGACY_API=0 explicitly in pilot/production deployments;
# callers should migrate to /pilot/* endpoints and /health.
# CLEARPROOF_PROFILE=pilot
# CLEARPROOF_ENABLE_LEGACY_API=0

# === Pilot events and Fireblocks relay (loaded once at FastAPI lifespan startup) ===
# Invalid JSON or schemas fail startup; unset leaves the corresponding route returning 503.
# PILOT_EVENT_AUTHORITIES={"authorities":[]}
# PILOT_INVESTIGATION_LINKS={"links":[]}
# PILOT_FIREBLOCKS_INTEGRATIONS={"integrations":[]}

# === Durable current-profile proving (operator configuration) ===
# DATABASE_URL=<PostgreSQL connection; keep in a secret manager>
# PILOT_PROVING_FACTORY=operator_pilot:configure
# Current-profile inspection and authorization targets (same contract; unset = routes answer 503):
# PILOT_INSPECTION_FACTORY=operator_pilot:inspection_targets
# PILOT_AUTHORIZATION_FACTORY=operator_pilot:authorization_targets
# The API and separate Linux worker share database, PII keyring and pinned targets.
# Worker: uv run python -m src.prover.proof_job_worker
# See docs/operations/pilot-proving-jobs.md for admission limits and recovery.
# Optional native backend, selected by the operator factory's select_pilot_backend(js).
# CLEARPROOF_RAPIDSNARK_BIN=/operator/versioned/prover
# CLEARPROOF_RAPIDSNARK_SHA256=<independently approved binary SHA256>
# Absence falls back to JS; explicit invalid paths or pins fail closed.
# Optional native C Poseidon accelerator (see docs/operations/native-poseidon.md).
# CLEARPROOF_POSEIDON_BACKEND=auto   # "auto" (default), "native" (require), or "python"
# CLEARPROOF_POSEIDON_LIB=           # Optional explicit path to _poseidon_native.{so,dylib,dll}

# === Recipient encryption and discovery (development profile 0.4.0) ===
PII_ENVELOPE_MODE=hpke-v2
HPKE_DISCOVERY_ENABLED=1
DISCOVERY_PRIVATE_DESTINATIONS={}
# Set an HPKE public key or configure the beneficiary DID for discovery.
# BENEFICIARY_HPKE_PUBLIC_KEY=<base64url X25519 public key>
# To publish discovery, set VASP_DOMAIN and a matching VASP_DID and HPKE key.
# VASP_DOMAIN=vasp.example.com
# VASP_HPKE_PRIVATE_KEY=<base64url X25519 private key; store in a secret manager>
# See specs/well-known-clearproof.md for migration and private enterprise policy.

# === Deployment (contract operations only) ===
DEPLOYER_PRIVATE_KEY=    # Wallet private key for contract deployment
SEPOLIA_RPC_URL=         # Sepolia RPC endpoint (e.g., Alchemy/Infura)

# === Wallet ownership (SIWE profile, AIF-87) ===
# PILOT_CHAIN_ID and PILOT_REGISTRY_ADDRESS are required at API startup and bind
# wallet evidence to the deployment's chain and registry.
# PILOT_CHAIN_ID=31337
# PILOT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# PILOT_SIWE_DOMAIN: when set, /wallet/ownership/challenge issues EIP-4361 (SIWE)
#   v2 challenges (e.g. clearproof.example). Unset keeps the legacy v1 profile.
# PILOT_SIWE_DOMAIN=clearproof.example
# WALLET_OWNERSHIP_RPC_URL: when set, verification records the EIP-7702 delegation
#   status and supports ERC-1271/ERC-6492 smart-account verification.
#   Constructed once during FastAPI lifespan and disconnected on shutdown.
# WALLET_OWNERSHIP_RPC_URL=<JSON-RPC endpoint>
# WALLET_OWNERSHIP_RPC_TIMEOUT_SECONDS=<RPC request timeout in seconds; default 10>
# WALLET_OWNERSHIP_DELEGATION_RECHECK_SECONDS=<lazy re-check interval; default 3600>

# === Rate limiting (PostgreSQL-backed when DATABASE_URL is set; see src/api/middleware/rate_limit.py) ===
# Multi-worker/replica safe when DATABASE_URL is set (atomic INSERT ... ON CONFLICT DO UPDATE in
# api_rate_limit_buckets with DB-clock expiry and bounded cleanup). Falls back to process-local
# in-memory OrderedDict counters ONLY when DATABASE_URL is absent.
# RATE_LIMIT_TRUSTED_PROXIES=              # Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = ignore XFF)
# RATE_LIMIT_MAX_CLIENTS=10000             # Max tracked client buckets (bounded cleanup / LRU eviction)
# Per-route-tier overrides (<PREFIX>_MAX_REQUESTS and <PREFIX>_WINDOW_SECONDS):
# RATE_LIMIT_AUTH_NONCE_MAX_REQUESTS=60
# RATE_LIMIT_AUTH_VERIFY_MAX_REQUESTS=30
# RATE_LIMIT_PILOT_PROOF_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_AUTHORIZATION_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_PROOF_JOBS_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_CREDENTIAL_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_POLICY_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_EVENTS_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_FIREBLOCKS_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_READINESS_MAX_REQUESTS=120
# RATE_LIMIT_PILOT_USAGE_MAX_REQUESTS=120
# RATE_LIMIT_WALLET_OWNERSHIP_MAX_REQUESTS=60
