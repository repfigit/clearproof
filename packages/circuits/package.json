{
  "name": "@clearproof/circuits",
  "version": "0.7.0",
  "description": "Circom source for the clearproof proof profiles (pilot-transfer-v3 and the legacy demo circuit). Source only: no compiled artifacts or proving keys.",
  "license": "Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./circuits/*": "./circuits/*",
    "./package.json": "./package.json"
  },
  "files": [
    "circuits/",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/repfigit/clearproof.git",
    "directory": "packages/circuits"
  },
  "homepage": "https://github.com/repfigit/clearproof",
  "keywords": [
    "zk",
    "zero-knowledge",
    "circom",
    "groth16",
    "snarkjs",
    "compliance",
    "travel-rule",
    "sanctions",
    "clearproof"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/sync.mjs",
    "prepack": "node scripts/sync.mjs",
    "test": "node scripts/sync.mjs && vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "circomlib": "^2.0.5"
  }
}
