{
  "name": "@clearproof/content",
  "version": "0.4.0",
  "description": "Single source of truth for all clearproof developer-facing content",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "content"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/repfigit/clearproof.git",
    "directory": "packages/content"
  },
  "homepage": "https://github.com/repfigit/clearproof",
  "keywords": [
    "clearproof",
    "content",
    "documentation",
    "zk",
    "compliance"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**/*.ts\" --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.4",
    "vitest": "^4.1.5"
  }
}
