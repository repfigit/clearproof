{
  "name": "@clearproof/cli",
  "version": "0.7.2",
  "description": "CLI for generating and verifying ZK compliance proofs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "clearproof": "./dist/index.js"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/repfigit/clearproof.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/repfigit/clearproof",
  "keywords": [
    "zk",
    "zero-knowledge",
    "compliance",
    "travel-rule",
    "cli",
    "clearproof"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**/*.ts\" --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100"
  },
  "dependencies": {
    "@clearproof/content": "^0.7.2",
    "@clearproof/proof": "^0.7.2",
    "chalk": "^6.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
