{
  "name": "@clearproof/contracts",
  "version": "0.7.2",
  "description": "Solidity sources and ABIs for the Clearproof pilot-transfer-v3 contracts and the legacy 16-signal demo contracts. Unaudited; not a deployment",
  "license": "Apache-2.0",
  "files": [
    "contracts/",
    "artifacts/contracts/**/*.json",
    "!artifacts/contracts/**/*.dbg.json",
    "!contracts/MockVerifier.sol",
    "!contracts/PairingHarness.sol",
    "!contracts/test/",
    "!artifacts/contracts/MockVerifier.sol/",
    "!artifacts/contracts/PairingHarness.sol/",
    "!artifacts/contracts/test/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/repfigit/clearproof.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/repfigit/clearproof",
  "keywords": [
    "zk",
    "zero-knowledge",
    "groth16",
    "solidity",
    "verifier",
    "compliance",
    "travel-rule",
    "ethereum"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:multi": "hardhat run scripts/deploy-multichain.ts",
    "update-sanctions": "hardhat run scripts/update-sanctions-root.ts",
    "relay-sanctions": "ts-node scripts/relay-sanctions-root.ts",
    "typecheck": "hardhat typechain && tsc --noEmit",
    "test:coverage": "hardhat coverage && npm run coverage:check",
    "coverage:check": "istanbul check-coverage --statements 100 --branches 100 --functions 100 --lines 100 coverage/coverage-final.json"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1",
    "dotenv": "^18.0.9",
    "hardhat": "^2.22",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
