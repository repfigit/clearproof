        "effective_until": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Effective Until",
          "type": "integer"
        },
        "tier_thresholds_usd_cents": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^(0|[1-9][0-9]{0,38})$",
              "type": "string"
            },
            {
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^(0|[1-9][0-9]{0,38})$",
              "type": "string"
            },
            {
              "maxLength": 39,
              "minLength": 1,
              "pattern": "^(0|[1-9][0-9]{0,38})$",
              "type": "string"
            }
          ],
          "title": "Tier Thresholds Usd Cents",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PolicySource"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "maxItems": 64,
          "title": "Rules",
          "type": "array"
        }
      },
