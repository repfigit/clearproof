{
  "name": "clearproof",
  "version": "0.4.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "description": "Circom circuits for ZK Travel Rule Compliance Bridge",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test:scripts": "vitest run --config vitest.scripts.config.mjs",
    "test:scripts:coverage": "vitest run --config vitest.scripts.config.mjs --coverage",
    "build": "turbo run build",
    "test:ts": "turbo run test",
    "compile": "bash scripts/compile_circuits.sh",
    "test:circuits": "uv run python -m pytest tests/unit/test_circuits.py -v",
    "test": "uv run python -m pytest tests/ -v",
    "test:unit": "uv run python -m pytest tests/unit/ -v",
    "test:integration": "uv run python -m pytest tests/integration/ -v",
    "test:compliance": "uv run python -m pytest tests/compliance/ -v"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6"
  },
  "overrides": {
    "bfj": "9.1.3",
    "nextra": {
      "zod": "4.3.6"
    },
    "nextra-theme-docs": {
      "zod": "4.3.6"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "turbo": "^2.0",
    "vitest": "^4.1.11"
  }
}
