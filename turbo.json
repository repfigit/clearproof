{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "CLEARPROOF_PILOT_TEST_ARTIFACTS",
        "CLEARPROOF_LEGACY_TEST_ARTIFACTS",
        "CLEARPROOF_TEST_PYTHON",
        "BLS_ARTIFACTS_DIR",
        "TMPDIR"
      ]
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
