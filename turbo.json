{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@clearproof/circuits#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/circuits/*.circom",
        "$TURBO_ROOT$/circuits/lib/**/*.circom"
      ],
      "outputs": ["circuits/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "CLEARPROOF_PILOT_TEST_ARTIFACTS",
        "CLEARPROOF_LEGACY_TEST_ARTIFACTS",
        "CLEARPROOF_TEST_PYTHON",
        "BLS_ARTIFACTS_DIR",
        "TMPDIR"
      ]
    }
  }
}
